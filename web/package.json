{
	"name": "organizer-web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"gen:api": "openapi-typescript ../docs/openapi.json -o src/lib/api/schema.d.ts",
		"predev": "npm run gen:api",
		"dev": "vite dev",
		"prebuild": "npm run gen:api",
		"build": "vite build",
		"preview": "vite preview",
		"precheck": "npm run gen:api",
		"check": "svelte-kit sync && svelte-check && prettier --check . && eslint .",
		"test": "vitest run"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"openapi-fetch": "^0.17.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.10.0",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	}
}
